10 REM CONTROL FLOW
20 FOR I=1 TO 3
30 FOR J=1 TO 2
40 PRINT I*10+J;
50 NEXT
60 NEXT
70 PRINT
80 K=2
90 ON K GOTO 100,120,140
100 PRINT "ONE"
110 GOTO 150
120 PRINT "TWO"
130 GOTO 150
140 PRINT "THREE"
150 ON K GOSUB 200,210
160 FOR I=10 TO 1 STEP -3
170 PRINT I;
180 NEXT
190 PRINT
195 END
200 PRINT "S1"
205 RETURN
210 PRINT "S2"
215 RETURN
