10 REM STRINGS
20 A$="FAMILY"
30 B$="BASIC"
40 PRINT A$;B$
50 PRINT LEN(A$);LEN(B$)
60 PRINT LEFT$(A$,3);RIGHT$(A$,3)
70 PRINT MID$(A$,2,3)
80 PRINT ASC(A$);CHR$(66)
90 PRINT STR$(1234);VAL("567")
100 PRINT HEX$(255)
110 PRINT INSTR(A$,"MIL")
120 C$=A$+B$
130 PRINT C$;LEN(C$)
140 IF A$<B$ THEN PRINT "LT"
150 IF A$>B$ THEN PRINT "GT"
160 SWAP A$,B$
170 PRINT A$;B$
180 END
